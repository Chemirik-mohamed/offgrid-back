# Copier ce fichier en .env puis remplacer les valeurs.
# Ne jamais commiter le vrai .env.

# Base PostgreSQL utilisée par Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/offgrid_dev?schema=public"

# Better Auth
# URL publique du backend
BETTER_AUTH_URL=http://localhost:3000
# Secret aléatoire (32+ caractères), ex. : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Port d'écoute du serveur Express
PORT=3000

# URL du frontend (utilisée pour générer les liens client d'intake)
FRONTEND_URL=http://localhost:5173
